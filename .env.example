# 1) Paste the token BotFather gives you. Never commit the real file.
TELOXIDE_TOKEN=replace_me

# 2) PostgreSQL connection string. Docker Compose uses this exact local default.
DATABASE_URL=postgres://loghmeh:loghmeh_dev_password@localhost:5432/loghmeh

# 3) Public HTTPS address of this app. It is used only for payment callbacks.
PUBLIC_BASE_URL=https://bot.example.com

# 4) Comma-separated Telegram numeric IDs allowed to use /admin.
ADMIN_TELEGRAM_IDS=123456789

# 5) AbanGateway. Keep test_ while learning; switch only after an end-to-end test.
ABAN_API_TOKEN=test_replace_me
ABAN_WEBHOOK_SECRET=replace_with_a_long_random_value
ABAN_API_BASE_URL=https://abangateway.ir/api/v1

# 6) A second, separate secret for the browser-based admin panel/API.
ADMIN_API_TOKEN=replace_with_a_different_long_random_value

# 7) Delivery stays manual until a vetted, authorised provider is connected.
# Accepted values: manual, fragment_connector
FULFILLMENT_PROVIDER=manual
# Only needed for FULFILLMENT_PROVIDER=fragment_connector. This is a separate,
# signed connector for the sales-only Fragment account and wallet.
FULFILLMENT_ENDPOINT=
FULFILLMENT_HMAC_SECRET=

RUST_LOG=info,loghmeh=debug
APP_BIND_ADDRESS=0.0.0.0:8080
